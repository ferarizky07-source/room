<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>F1 Workshop Racing Challenge - Ferrari vs McLaren</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family: 'Segoe UI', Tahoma, sans-serif; }
  :root {
    --ferrari-red: #dc0000;
    --ferrari-dark: #8b0000;
    --mclaren-orange: #ff8000;
    --mclaren-dark: #cc6600;
    --carbon: #1a1a1a;
    --asphalt: #2c2c2c;
    --gold: #ffd700;
    --green: #00d26a;
  }
  body {
    min-height: 100vh;
    background: 
      radial-gradient(ellipse at top, #2c3e50 0%, #0f0f1e 50%, #000 100%);
    color: #fff;
    overflow-x: hidden;
    position: relative;
  }
  body::before {
    content: '';
    position: fixed;
    top:0; left:0; right:0; bottom:0;
    background-image: 
      repeating-linear-gradient(45deg, transparent, transparent 35px, rgba(255,255,255,0.02) 35px, rgba(255,255,255,0.02) 70px);
    pointer-events: none;
    z-index: 0;
  }
  .screen {
    display: none;
    min-height: 100vh;
    padding: 20px;
    position: relative;
    z-index: 1;
  }
  .screen.active { display: flex; flex-direction: column; align-items: center; justify-content: center; }

  /* ============ MENU SCREEN ============ */
  #menuScreen {
    background: 
      linear-gradient(135deg, rgba(220,0,0,0.15) 0%, rgba(0,0,0,0.8) 50%, rgba(255,128,0,0.15) 100%);
  }
  .menu-container {
    text-align: center;
    max-width: 1100px;
    width: 100%;
  }
  .main-title {
    font-size: clamp(2em, 6vw, 4.5em);
    font-weight: 900;
    letter-spacing: 3px;
    background: linear-gradient(90deg, var(--ferrari-red), #fff, var(--mclaren-orange));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 40px rgba(255,255,255,0.3);
    margin-bottom: 10px;
    line-height: 1.1;
    font-style: italic;
  }
  .subtitle {
    font-size: clamp(0.9em, 2vw, 1.3em);
    color: #ccc;
    margin-bottom: 40px;
    font-style: italic;
    letter-spacing: 2px;
  }
  .cars-display {
    display: flex;
    justify-content: space-around;
    align-items: center;
    margin: 30px 0;
    flex-wrap: wrap;
    gap: 20px;
  }
  .car-card {
    background: rgba(0,0,0,0.6);
    border-radius: 20px;
    padding: 25px;
    width: 280px;
    border: 3px solid;
    transition: transform 0.3s;
    backdrop-filter: blur(10px);
  }
  .car-card:hover { transform: translateY(-5px) scale(1.03); }
  .car-card.ferrari { border-color: var(--ferrari-red); box-shadow: 0 0 30px rgba(220,0,0,0.5); }
  .car-card.mclaren { border-color: var(--mclaren-orange); box-shadow: 0 0 30px rgba(255,128,0
